# MPLADS Spring Boot Backend Environment Variables

# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database (Production Profile)
DATABASE_URL=jdbc:postgresql://localhost:5432/mplads_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Security & JWT (256-Bit Key)
JWT_SECRET=9a7f8e6d5c4b3a210987654321fedcba0123456789abcdef0123456789abcdef
JWT_EXPIRATION_MS=86400000

# AI Microservice URL
AI_SERVICE_URL=http://localhost:8000
