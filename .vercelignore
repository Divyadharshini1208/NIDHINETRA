# ==============================================================================
# Vercel Deployment Ignore Rules for NIDHINETRA
# Prevents Vercel from bundling backend, AI service, datasets, or caches
# ==============================================================================

# Backend microservices excluded from Vercel (Deployed separately on Render / Railway / Cloud Server)
backend/
database/

# Development, tests, and temporary artifacts
scratch/
docs/
.pytest_cache/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
.venv/
env/
venv/

# Environment files
.env
.env.local
.env.*.local

# Local scripts and run files
run-all.bat
run-all.sh
start.ps1

# Test output and audit markdown files
e2e_results.json
temp_home.html
PERFORMANCE_AUDIT.md
IMPLEMENTATION_SUMMARY.md
