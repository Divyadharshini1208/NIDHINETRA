# ==============================================================================
# Vercel Deployment Ignore Rules for NIDHINETRA
# Prevents Vercel from bundling backend, AI service, datasets, or caches
# ==============================================================================

# Microservices to exclude from Vercel (Deployed separately on Render / Railway / Docker)
ai-service/
backend/
database/

# Development, tests, and temporary artifacts
scratch/
docs/
.pytest_cache/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
.venv/
env/
venv/

# Environment files
.env
.env.local
.env.*.local

# Docker and local scripts
docker-compose.yml
docker-start.bat
docker-start.sh
run-all.bat
start.ps1
Dockerfile
.dockerignore

# Test output and audit markdown files
e2e_results.json
temp_home.html
PERFORMANCE_AUDIT.md
IMPLEMENTATION_SUMMARY.md
DOCKER.md
