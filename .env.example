# ==============================================================================
# MPLADS AI-Powered Monitoring & Decision Support Portal - Environment Variables
# Ministry of Statistics & Programme Implementation (MoSPI), Government of India
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Service Configuration (Spring Boot 3 / Java 21)
# ------------------------------------------------------------------------------
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database Configuration (Used when SPRING_PROFILES_ACTIVE=prod)
DATABASE_URL=jdbc:postgresql://localhost:5432/mplads_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# H2 Database Configuration (Used when SPRING_PROFILES_ACTIVE=dev)
SPRING_DATASOURCE_URL=jdbc:h2:mem:mpladsdb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE;MODE=PostgreSQL
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# JWT Authentication Security Settings
JWT_SECRET=9a7f8e6d5c4b3a210987654321fedcba0123456789abcdef0123456789abcdef
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 2. Frontend Application Configuration (Next.js 14 / TypeScript)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# 3. AI / ML Microservice Configuration (FastAPI / Python - Phase 2)
# ------------------------------------------------------------------------------
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=http://localhost:8000
