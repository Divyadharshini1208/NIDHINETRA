{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "functions": {
    "main.py": {
      "includeFiles": "models/**",
      "maxDuration": 30
    },
    "api/index.py": {
      "includeFiles": "models/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/main.py"
    }
  ]
}
